# =============================================================================
# Lightsail流量配额监控系统 - 环境变量配置文件
# =============================================================================

# AWS区域配置
# 需要监控的Lightsail区域列表，用逗号分隔
# 支持的区域: us-east-1, us-east-2, us-west-2, eu-west-1, eu-west-2, eu-central-1, 
#           ap-south-1, ap-southeast-1, ap-southeast-2, ap-northeast-1, ap-northeast-2
LIGHTSAIL_REGIONS=us-east-2,ap-northeast-2

# 风险评估阈值配置
# 高风险实例识别阈值：日均流量超过此值(GB)的实例将被标记为高风险，需要重点监控
HIGH_RISK_DAILY_GB_THRESHOLD=10

# 当前使用率告警阈值：当实例本月流量使用率达到此百分比时触发告警
ALERT_USAGE_PERCENT_THRESHOLD=75

# 预测告警阈值：当预测月底使用率达到此百分比时触发告警
PREDICTION_ALERT_THRESHOLD=90

# 默认配额设置
# 当无法识别实例套餐类型时使用的默认流量配额(GB)
DEFAULT_QUOTA_GB=1024

# Lightsail套餐包流量配额映射 (单位: GB)
# 根据AWS Lightsail官方套餐包配置，每个套餐包对应的月度流量配额
BUNDLE_NANO_QUOTA=1024      # $5 套餐: 1TB流量
BUNDLE_MICRO_QUOTA=2048     # $7 套餐: 2TB流量
BUNDLE_SMALL_QUOTA=3072     # $12.00套餐: 3TB流量
BUNDLE_MEDIUM_QUOTA=4096    # $24.00套餐: 4TB流量
BUNDLE_LARGE_QUOTA=5120     # $44.00套餐: 5TB流量
BUNDLE_XLARGE_QUOTA=6144    # $84.00套餐: 6TB流量

# 分级告警阈值配置 (单位: 百分比)
# 当实例流量使用率达到以下百分比时，系统将发送对应级别的告警
ALERT_THRESHOLD_MEDIUM=75   # 中级告警: 75% - 预警通知，建议关注
ALERT_THRESHOLD_HIGH=85     # 高级告警: 85% - 需要采取行动
ALERT_THRESHOLD_CRITICAL=95 # 紧急告警: 95% - 立即处理，避免超出配额

# API调用频率限制配置
# AWS Lightsail API限制: get_instances(2次/秒), get_instance_metric_data(10次/秒)
# API调用间隔时间(秒)，避免触发AWS API限制
API_DELAY_SECONDS=0.1

# 区域切换间隔时间(秒)，在处理不同区域之间的暂停时间
REGION_DELAY_SECONDS=5

# 并发处理配置
# 最大并发工作线程数，建议根据API限制调整(Lightsail限制10次/秒)
MAX_CONCURRENT_WORKERS=10

# 批次处理大小，每批处理的实例数量
BATCH_SIZE=100

# 批次间延迟时间(秒)，避免API限制
BATCH_DELAY_SECONDS=2

# AWS服务配置
# SNS主题名称，用于发送告警通知
SNS_TOPIC_NAME=LightsailQuotaAlerts

# CloudWatch自定义指标命名空间
# 配额监控指标的命名空间
CLOUDWATCH_NAMESPACE_QUOTA=Lightsail/QuotaMonitor

# 聚合监控指标的命名空间
CLOUDWATCH_NAMESPACE_AGGREGATED=Lightsail/Aggregated

# 成本分析配置
# Cost Explorer分析的天数，用于获取历史成本数据进行流量分析
COST_ANALYSIS_DAYS=30

# 输出文件配置
# 智能监控报告文件名
INTELLIGENT_REPORT_FILE=intelligent_quota_report.json

# 配额监控详细报告文件名
QUOTA_REPORT_FILE=quota_monitor_report.json

# 告警实例文件配置
# 不同级别告警实例将保存到以下文件中，用于批量管理
# alert_medium_instances.json   - 中级告警实例 (75-84%)
# alert_high_instances.json     - 高级告警实例 (85-94%)
# alert_critical_instances.json - 紧急告警实例 (95%+)